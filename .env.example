# Copia este archivo como .env (no se sube a git). Contraseñas al azar: openssl rand -base64 24 | tr -d '/+='
# Para comentarios usa líneas aparte (nada detrás del valor).

# Postgres: superusuario `admin`
POSTGRES_PASSWORD=
# Postgres: rol `odoo` (lo usa Odoo; puede crear bases de datos)
ODOO_PASSWORD=
# Postgres: base antigua `rutinas` de fuertafit (solo para migrar a Odoo)
RUTINAS_PASSWORD=

# Odoo: contraseña maestra del gestor de bases de datos (/web/database/manager)
ODOO_MASTER_PASSWORD=

# Opcional: entrenador con IA de fuerta_rutinas (de pago; además hay que descomentar el SDK en el Dockerfile)
# ANTHROPIC_API_KEY=
