<?xml version="1.0" encoding="utf-8"?>
<!-- Para crear builds hay que tener cuenta: al instalar el módulo se abre el registro libre («Crear cuenta» en el
     login) en todos los sitios web de la base. Cada sitio tiene su propio ajuste, que manda sobre el general
     (auth_signup.invitation_scope). Solo al instalar (noupdate): si luego se cambia en Ajustes → Sitio web, se respeta.
     Las cuentas nuevas son de portal: pueden guardar builds, no entran al backend. -->
<odoo noupdate="1">
    <function model="website" name="write">
        <function model="website" name="search" eval="[[]]"/>
        <value eval="{'auth_signup_uninvited': 'b2c'}"/>
    </function>
</odoo>
