<?xml version="1.0" encoding="utf-8"?>
<!-- Acceso al backend del módulo (Ajustes → Usuarios): «Usuario» ve el catálogo, «Administrador» lo edita y lo
     actualiza. La web /dbd es pública y no depende de estos grupos. Al instalar, Dani (base.user_admin) es administrador. -->
<odoo>
    <record id="module_category_dbd" model="ir.module.category">
        <field name="name">Dead by Daylight</field>
        <field name="sequence">61</field>
    </record>

    <record id="privilege_dbd" model="res.groups.privilege">
        <field name="name">Dead by Daylight</field>
        <field name="description">Catálogo de Dead by Daylight en el backend.</field>
        <field name="category_id" ref="module_category_dbd"/>
    </record>

    <record id="group_dbd_user" model="res.groups">
        <field name="name">Usuario</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_dbd"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_dbd_manager" model="res.groups">
        <field name="name">Administrador</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_dbd"/>
        <field name="implied_ids" eval="[(4, ref('group_dbd_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
