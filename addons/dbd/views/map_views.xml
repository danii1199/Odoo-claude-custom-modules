<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="realm_view_list" model="ir.ui.view">
        <field name="name">dbd.realm.list</field>
        <field name="model">dbd.realm</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="map_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="realm_view_form" model="ir.ui.view">
        <field name="name">dbd.realm.form</field>
        <field name="model">dbd.realm</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title"><h1><field name="name" placeholder="Nombre del reino"/></h1></div>
                    <field name="active" invisible="1"/>
                    <notebook>
                        <page string="Mapas" name="maps">
                            <field name="map_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="size"/>
                                </list>
                            </field>
                        </page>
                        <page string="Descripción" name="description">
                            <field name="description"/>
                        </page>
                        <page string="Ofrendas" name="offerings">
                            <field name="offering_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="rarity"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_realms" model="ir.actions.act_window">
        <field name="name">Reinos</field>
        <field name="res_model">dbd.realm</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="map_view_list" model="ir.ui.view">
        <field name="name">dbd.map.list</field>
        <field name="model">dbd.map</field>
        <field name="arch" type="xml">
            <list>
                <field name="image" widget="image" options="{'size': [48, 32]}"/>
                <field name="name"/>
                <field name="realm_id"/>
                <field name="size"/>
            </list>
        </field>
    </record>

    <record id="map_view_form" model="ir.ui.view">
        <field name="name">dbd.map.form</field>
        <field name="model">dbd.map</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title"><h1><field name="name" placeholder="Nombre del mapa"/></h1></div>
                    <group>
                        <field name="realm_id"/>
                        <field name="size"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="map_view_search" model="ir.ui.view">
        <field name="name">dbd.map.search</field>
        <field name="model">dbd.map</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="realm_id"/>
                <filter name="archived" string="Archivados" domain="[('active', '=', False)]"/>
                <filter name="by_realm" string="Reino" context="{'group_by': 'realm_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_maps" model="ir.actions.act_window">
        <field name="name">Mapas</field>
        <field name="res_model">dbd.map</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_by_realm': 1}</field>
    </record>
</odoo>
