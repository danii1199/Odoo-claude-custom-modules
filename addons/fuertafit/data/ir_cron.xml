<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Plan automático: rellena los días vacíos de la semana de quien lo tenga activado. -->
    <record id="cron_auto_plan" model="ir.cron">
        <field name="name">Mi rutina Fuerta: plan automático</field>
        <field name="model_id" ref="model_fuerta_settings"/>
        <field name="state">code</field>
        <field name="code">model._cron_auto_plan()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
