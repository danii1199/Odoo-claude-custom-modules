<?xml version="1.0" encoding="utf-8"?>
<!-- Entrada «Mi rutina» en el menú del sitio web (editable luego desde Sitio web → Menús). -->
<odoo>
    <data noupdate="1">
        <record id="website_menu_fuerta" model="website.menu">
            <field name="name">Mi rutina</field>
            <field name="url">/fuerta</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence">20</field>
        </record>
    </data>
    <!-- Solo la ve quien tiene acceso al módulo. Fuera del noupdate para que se aplique también al actualizar, y a
         todas las entradas de /fuerta: Odoo copia el menú para cada sitio web y la copia es la que se ve. -->
    <data noupdate="0">
        <function model="website.menu" name="write">
            <function model="website.menu" name="search" eval="[[('manual_url', '=', '/fuerta')]]"/>
            <value eval="{'group_ids': [(6, 0, [ref('group_fuerta_user')])]}"/>
        </function>
    </data>
</odoo>
