<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_open_web" model="ir.actions.act_url">
        <field name="name">Mi rutina Fuerta</field>
        <field name="url">/fuerta</field>
        <field name="target">self</field>
    </record>

    <menuitem id="menu_root" name="Mi rutina Fuerta" action="action_plan" web_icon="fuertafit,static/description/icon.png" sequence="1"/>
    <menuitem id="menu_web" name="Abrir la web" parent="menu_root" action="action_open_web" sequence="1"/>
    <menuitem id="menu_data" name="Mis datos" parent="menu_root" sequence="10"/>
    <menuitem id="menu_plan" name="Planificado" parent="menu_data" action="action_plan" sequence="1"/>
    <menuitem id="menu_history" name="Historial" parent="menu_data" action="action_history" sequence="2"/>
    <menuitem id="menu_day_status" name="Días especiales" parent="menu_data" action="action_day_status" sequence="3"/>
    <menuitem id="menu_settings" name="Mis ajustes" parent="menu_data" action="action_my_settings" sequence="4"/>
    <menuitem id="menu_catalog" name="Catálogo" parent="menu_root" sequence="20"/>
    <menuitem id="menu_routines" name="Rutinas" parent="menu_catalog" action="action_routines" sequence="1"/>
    <menuitem id="menu_routine_import" name="Importar rutinas" parent="menu_catalog" action="action_routine_import" sequence="2"/>
</odoo>
