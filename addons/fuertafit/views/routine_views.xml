<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="routine_view_list" model="ir.ui.view">
        <field name="name">fuerta.routine.list</field>
        <field name="model">fuerta.routine</field>
        <field name="arch" type="xml">
            <list create="false" edit="false">
                <header>
                    <button name="%(action_routine_import)d" type="action" string="Importar rutinas" display="always"/>
                </header>
                <field name="name"/>
                <field name="duration_minutes" sum="Total"/>
                <field name="group"/>
                <field name="training_type"/>
                <field name="intensity"/>
                <field name="trainers" optional="hide"/>
                <field name="materials" optional="show"/>
                <field name="publish_date"/>
                <field name="url" widget="url" text="Abrir en FuertaFit"/>
                <field name="proposable" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="routine_view_form" model="ir.ui.view">
        <field name="name">fuerta.routine.form</field>
        <field name="model">fuerta.routine</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="fuerta_id"/>
                            <field name="duration_minutes"/>
                            <field name="group"/>
                            <field name="methodology"/>
                            <field name="training_type"/>
                            <field name="intensity"/>
                        </group>
                        <group>
                            <field name="trainers"/>
                            <field name="materials"/>
                            <field name="publish_date"/>
                            <field name="url" widget="url" text="Abrir en FuertaFit"/>
                            <field name="proposable"/>
                        </group>
                    </group>
                    <field name="preview_image" widget="image_url" options="{'size': [320, 180]}"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="routine_view_search" model="ir.ui.view">
        <field name="name">fuerta.routine.search</field>
        <field name="model">fuerta.routine</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="trainers"/>
                <field name="methodology"/>
                <filter name="proposable" string="Se proponen" domain="[('proposable', '=', True)]"/>
                <separator/>
                <filter name="by_group" string="Grupo muscular" context="{'group_by': 'group'}"/>
                <filter name="by_type" string="Tipo" context="{'group_by': 'training_type'}"/>
                <filter name="by_intensity" string="Intensidad" context="{'group_by': 'intensity'}"/>
            </search>
        </field>
    </record>

    <record id="action_routines" model="ir.actions.act_window">
        <field name="name">Catálogo de rutinas</field>
        <field name="res_model">fuerta.routine</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Catálogo vacío</p>
            <p>Usa la pestaña «Actualizar» de la web para traer las rutinas de FuertaFit con el marcador, o «Importar rutinas».</p>
        </field>
    </record>
</odoo>
