<?xml version="1.0" encoding="utf-8"?>
<!-- Datos de cada usuario: lo mismo que se crea desde la web /fuerta se puede crear y editar aquí. -->
<odoo>
    <record id="plan_view_list" model="ir.ui.view">
        <field name="name">fuerta.plan.list</field>
        <field name="model">fuerta.plan</field>
        <field name="arch" type="xml">
            <list editable="bottom" default_group_by="day">
                <header>
                    <button name="action_plan_this_week" type="object" string="Generar esta semana" display="always"/>
                    <button name="action_plan_next_week" type="object" string="Generar la semana que viene" display="always"/>
                </header>
                <field name="sequence" widget="handle"/>
                <field name="day"/>
                <field name="routine_id"/>
                <field name="duration_minutes" sum="Total"/>
                <field name="note"/>
                <field name="source"/>
                <field name="url" widget="url" text="Abrir" optional="show"/>
                <field name="done"/>
                <button name="action_mark_done" type="object" string="Hecha" icon="fa-check" invisible="done"/>
                <button name="action_unmark_done" type="object" string="Deshacer" icon="fa-undo" invisible="not done"/>
            </list>
        </field>
    </record>

    <record id="plan_view_form" model="ir.ui.view">
        <field name="name">fuerta.plan.form</field>
        <field name="model">fuerta.plan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_done" type="object" string="Marcar como hecha" class="btn-primary" invisible="done"/>
                    <button name="action_unmark_done" type="object" string="Desmarcar" invisible="not done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="day"/>
                            <field name="routine_id"/>
                            <field name="duration_minutes"/>
                            <field name="url" widget="url" text="Abrir en FuertaFit"/>
                        </group>
                        <group>
                            <field name="note"/>
                            <field name="source"/>
                            <field name="sequence"/>
                            <field name="done"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="plan_view_calendar" model="ir.ui.view">
        <field name="name">fuerta.plan.calendar</field>
        <field name="model">fuerta.plan</field>
        <field name="arch" type="xml">
            <calendar date_start="day" mode="month" color="source" quick_create="false" event_open_popup="true">
                <field name="routine_id"/>
                <field name="duration_minutes"/>
            </calendar>
        </field>
    </record>

    <record id="action_plan" model="ir.actions.act_window">
        <field name="name">Planificado</field>
        <field name="res_model">fuerta.plan</field>
        <field name="view_mode">calendar,list</field>
    </record>

    <record id="history_view_list" model="ir.ui.view">
        <field name="name">fuerta.history.list</field>
        <field name="model">fuerta.history</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="done_on"/>
                <field name="routine_id"/>
            </list>
        </field>
    </record>

    <record id="action_history" model="ir.actions.act_window">
        <field name="name">Historial</field>
        <field name="res_model">fuerta.history</field>
        <field name="view_mode">list</field>
    </record>

    <record id="day_status_view_list" model="ir.ui.view">
        <field name="name">fuerta.day.status.list</field>
        <field name="model">fuerta.day.status</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <header>
                    <button name="%(action_away_wizard)d" type="action" string="Marcar ausencia (varios días)" display="always"/>
                </header>
                <field name="day"/>
                <field name="status"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="action_day_status" model="ir.actions.act_window">
        <field name="name">Días saltados, movidos y fuera</field>
        <field name="res_model">fuerta.day.status</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
